# Production / VPS (.env on the server — never commit)

POSTGRES_USER=luxury
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=luxury

# Built automatically by compose if you keep this in sync:
# DATABASE_URL=postgresql://luxury:PASSWORD@db:5432/luxury?schema=public

# Admin panel — required in Docker (boot fails if missing/weak)
# openssl rand -hex 24
ADMIN_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
# Min: password 12 chars, secret 32 chars. No placeholders.

NEXT_PUBLIC_SITE_URL=https://performance.zervtek.com
NEXT_PUBLIC_WHATSAPP_NUMBER=818066594632
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello, I'm interested in a vehicle.

# Google Tag Manager — performance.zervtek.com container
NEXT_PUBLIC_GTM_ID=GTM-5L8XN9VF

HERMES_VEHICLE_API_TOKEN=generate-with-openssl-rand-hex-32

VEHICLE_UPLOAD_DIR=/var/lib/zervtek-luxury/vehicle-images
VEHICLE_MEDIA_URL_PREFIX=/media/vehicles
VEHICLE_MAX_IMAGES=100
VEHICLE_MAX_IMAGE_SIZE_MB=15

# Inquiry notifications (Resend email + optional n8n webhook)
RESEND_API_KEY=re_...
INQUIRY_NOTIFY_FROM="ZervTek Performance <notify@performance.zervtek.com>"
INQUIRY_NOTIFY_TO=info@zervtek.com
INQUIRY_WEBHOOK_URL=https://n8n.zervtek.com/webhook/inquiry
INQUIRY_WEBHOOK_SECRET=
