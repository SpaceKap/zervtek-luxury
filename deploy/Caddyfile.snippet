# Drop into the VPS Caddyfile (same level as other site blocks).
#
# Caddy runs in Docker on the shared `caddy_proxy` network → proxy by
# container name. The media handler requires the Caddy container to have
# /srv/zervtek-luxury/vehicle-images mounted; if it doesn't, delete the
# handle_path block — the app serves /media/vehicles/* itself.
#
# Host/systemd Caddy instead: use `reverse_proxy 127.0.0.1:3010`.

performance.zervtek.com {
	encode gzip zstd

	# Optional: serve vehicle media directly from disk (needs volume mount
	# in the Caddy container: /srv/zervtek-luxury/vehicle-images:ro)
	# handle_path /media/vehicles/* {
	# 	root * /srv/zervtek-luxury/vehicle-images
	# 	file_server
	# 	header Cache-Control "public, max-age=31536000, immutable"
	# 	header X-Robots-Tag "noimageindex"
	# 	header X-Content-Type-Options "nosniff"
	# }

	reverse_proxy luxury-app:3000
}

luxury.zervtek.com {
	redir https://performance.zervtek.com{uri} permanent
}
